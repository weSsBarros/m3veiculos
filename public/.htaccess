<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # robots.txt e sitemap.xml saem do PHP (endereço do próprio site e carros do banco)
  RewriteRule ^robots\.txt$ api/robots.php [L]
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Evita listagem de diretórios
Options -Indexes

# Cabeçalhos de segurança: o painel não pode ser aberto dentro de outro site
# (clickjacking), o navegador não "adivinha" tipos de arquivo e links externos
# não recebem o endereço completo da página (que pode ter ids de clientes).
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
