# Fotos dos carros enviadas pelo painel (api/fotos.php). Só imagens: nada aqui
# dentro é executado e a pasta não é listada. Publicar o site nunca apaga esta
# pasta (o pacote só traz este arquivo).
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .pht .php3 .php4 .php5 .php7 .php8 .cgi .pl .py
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

# Foto que não existe dá 404 de verdade, em vez de cair no index.html do site
# (as regras da raiz não valem aqui). A única regra: a cópia em JPG para a OLX,
# que não aceita WebP. Na primeira vez o api/foto-jpg.php gera e guarda em
# carros/jpg/; depois o arquivo é servido direto.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^carros/jpg/([A-Za-z0-9-]{8,64})\.jpg$ /api/foto-jpg.php?f=$1 [L]
</IfModule>

# Os nomes são aleatórios e nunca reaproveitados: cache longo
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set X-Content-Type-Options "nosniff"
  # JPG fica JPG: o CDN da Hostinger troca por WebP para quem aceita WebP, e a
  # OLX só aceita JPG, PNG ou GIF
  <FilesMatch "\.(?i:jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable, no-transform"
  </FilesMatch>
</IfModule>
